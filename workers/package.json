{
  "name": "playground-workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create playground",
    "db:migrate": "wrangler d1 migrations apply playground --local",
    "db:migrate:prod": "wrangler d1 migrations apply playground --remote",
    "db:console": "wrangler d1 execute playground --local --command",
    "r2:create": "wrangler r2 bucket create playground-storage",
    "generate:client": "orval --config orval.config.ts",
    "generate:client:watch": "orval --config orval.config.ts --watch",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "check": "biome check --write src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "chanfana": "^2.8.3",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.7.11",
    "jose": "^6.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20251011.0",
    "@types/node": "^24.7.2",
    "@types/service-worker-mock": "^2.0.4",
    "@types/supertest": "^6.0.3",
    "orval": "^7.13.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.2"
  }
}
